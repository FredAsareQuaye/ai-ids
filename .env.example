# ─────────────────────────────────────────────────────────────────────────────
# AI-IDS Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── AI (OpenRouter) ────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=deepseek/deepseek-chat

# ── API Security ──────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
SIEM_API_KEY=change-me-to-a-strong-random-secret

# ── AI Autonomous Agent ───────────────────────────────────────────────────────
AI_AGENT_INTERVAL=60
AI_AGENT_BATCH=200
OFFICE_HOURS_START=8
OFFICE_HOURS_END=18
AI_AUTO_BLOCK=true
AI_AUTO_BLOCK_CONFIDENCE=0.85
AI_DIGEST_INTERVAL=3600

# ── Threat Feeds ──────────────────────────────────────────────────────────────
FEED_ENABLED=true
FEED_SYNC_INTERVAL_HOURS=6

# ── Alert Deduplication ───────────────────────────────────────────────────────
DEDUP_ENABLED=true
DEDUP_WINDOW_SECONDS=600

# ── Email Alerts (optional) ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# ── Slack / Webhook (optional) ───────────────────────────────────────────────
SLACK_WEBHOOK_URL=
WEBHOOK_URL=

# ── AbuseIPDB (optional) ─────────────────────────────────────────────────────
ABUSEIPDB_API_KEY=

# ── Syslog Receiver ───────────────────────────────────────────────────────────
SYSLOG_ENABLED=true
SYSLOG_HOST=0.0.0.0
SYSLOG_PORT=5140
